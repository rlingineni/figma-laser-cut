{
  "name": "figma-plugin-react-template",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:rlingineni/figma-plugin-react-template.git",
  "author": "Ravi Lingineni (rlingineni@live.com)",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=production concurrently \"rspack build --config rspack.config.js --watch\" \"yarn:watch-css\"",
    "build": "npm run build-css && NODE_ENV=production rspack build --config rspack.config.js",
    "build-css": "npx tailwindcss -i ./src/app/styles/input.css -o ./src/app/styles/ui.css",
    "watch-css": "npx tailwindcss -i ./src/app/styles/input.css -o ./src/app/styles/ui.css --watch",
    "api:dev": "IS_LOCAL=true deno run --allow-net --allow-read --allow-write --allow-env --watch api/main.ts",
    "api:deploy": "cd api && deno deploy --prod",
    "dev:full": "concurrently \"yarn:dev\" \"yarn:api:dev\""
  },
  "dependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@types/react": "^16.9.0",
    "@types/react-dom": "^16.9.0",
    "classnames": "^2.3.2",
    "events": "^3.3.0",
    "lucide-react": "^1.34.0",
    "postcss": "^8.2.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.3.0",
    "zustand": "^4.3.5"
  },
  "devDependencies": {
    "@rspack/cli": "^1.3.0",
    "@rspack/core": "^1.3.0",
    "@rspack/plugin-html": "^0.5.8",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^7.6.0",
    "css-loader": "^7.1.4",
    "daisyui": "^4.12.13",
    "tailwindcss": "^3.0.24",
    "tailwindcss-bg-patterns": "^0.3.0",
    "typescript": "^4.6.4"
  }
}
